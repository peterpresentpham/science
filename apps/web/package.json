{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-data": "pnpm --filter @chem/data build && node scripts/sync-data.mjs",
    "predev": "pnpm sync-data",
    "dev": "next dev -p 3011",
