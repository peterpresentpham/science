{
  "name": "@chem/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./elements.json": "./dist/elements.json",
    "./elements/*.json": "./dist/elements/*.json",
    "./photo": "./src/photo.ts",
    "./images/*": "./images/*",
    "./lenses": "./src/lenses.ts",
    "./story": "./src/story.ts",
    "./compounds.json": "./dist/compounds.json",
    "./nuclides.json": "./dist/nuclides.json"
  },
  "scripts": {
    "fetch": "tsx scripts/fetch.ts",
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "images": "tsx scripts/images.ts",
    "fetch:spectra": "tsx scripts/fetch-spectra.ts",
    "fetch:compounds": "tsx scripts/fetch-compounds.ts",
    "fetch:isotopes": "tsx scripts/fetch-isotopes.ts"
  },
  "dependencies": {
    "@chem/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
